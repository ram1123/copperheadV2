# .agent-system/ : task/workflow artifacts are intentionally version-controlled
# (auditability requirement), overriding the blanket *.json/*.yaml ignores
# above which target generated analysis config/output dumps elsewhere.
!.agent-system/**/*.json
!.agent-system/**/*.yaml
.agent-system/

# VBF DNN binning: generated by MVA_training/VBF_run3/scan_bins_for_dnn.py but
# imported at module load by modules/selection.py, so it must be tracked
# despite the blanket *.yaml ignore above.
!configs/MVA/VBF/dnn_binning.yaml