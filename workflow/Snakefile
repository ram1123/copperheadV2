          -l {params.label} \
          -y "{wildcards.year}" \
          -M 1 \
          -p "V1" \
          -m calib  \
          {params.gw}  \
          > {log} 2>&1
        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


