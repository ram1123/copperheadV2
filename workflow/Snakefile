# ---------------------------------------
# 2d) Stage-2 / Stage-3 (per year, after stage1Compact). stage2 always loads
# the VBF DNN model (see build_stage2_cmd's --model_tag/--model_path in
# common_workflow.sh), so it depends on dnn_train having produced one -- not
# wired into `rule all`/`all_stage1` for the same reason as dnn_train above.
# Request explicitly, e.g.:
#   snakemake -s workflow/Snakefile state/<run_tag>/stage3_2022preEE.done
# ---------------------------------------
rule stage2:
    input:
        lambda wc: [] if STAGE23_STANDALONE else [
            STATEDIR + f"/stage1_compact_{wc.year}.done",
            STATEDIR + "/dnn_train.done",
        ],
    output:
        done=STATEDIR + "/stage2_{year}{jjtag}.done",
    log:
        LOGDIR + "/stage2_{year}{jjtag}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: stage23_label(wc.year),
        gw=lambda wc: gw_flags(),
        model_env=(f"MODEL_LABEL={DNN_MODEL_LABEL} " if DNN_MODEL_LABEL else "")
        + (f"MODEL_YEARS={DNN_MODEL_YEARS} " if DNN_MODEL_YEARS else ""),
        var_env=VARIATIONS_ENV,
        postfix=SAVE_POSTFIX,
        jj_env=lambda wc: jj_env(wc.jjtag),
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {params.jj_env}{params.var_env}{params.model_env}PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m 2 \
            -o {params.postfix} \
            {params.gw} \
            > {log} 2>&1

        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


