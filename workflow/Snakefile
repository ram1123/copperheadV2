# Plotting-variation knobs -- configurable via workflow/config.yaml
# (plot_categories / plot_jj_eta_regions / plot_single_jet_eta_regions /
# plot_zpt_modes / plot_var_sets) rather than hand-edited here. 
PLOT_CATS = config.get("plot_categories", ["vbf", "ggh"])
JJ_ETA_REGIONS = config.get("plot_jj_eta_regions", ["all"])
SINGLE_JET_ETA_REGIONS = config.get("plot_single_jet_eta_regions", [])
PLOT_ZPT_MODES = config.get("plot_zpt_modes", ["withzpt"])  # ["withzpt", "nozpt"]
PLOT_VAR_SETS = config.get("plot_var_sets", ["fullset"])  # ["minset", "fullset"]
