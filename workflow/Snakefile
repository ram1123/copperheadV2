# ---------------------------------------
# 1) Stage-1 (all samples)
# ---------------------------------------
rule stage1:
    output:
        done=STATEDIR + "/stage1_{year}_rep{rep}.done",
    log:
        LOGDIR + "/stage1_{year}_rep{rep}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
        summary=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}/"
            "_status/stage1_summary.log"
        ),        
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m 1 \
          {params.gw}  \
          > {log} 2>&1
        summary="{params.summary}"

        if [[ ! -f "$summary" ]]; then
            echo "ERROR: stage1 summary log not found: $summary"
            exit 1
        fi

        failed=$(sed -n '2p' "$summary" | awk '{{print $4}}' )
        echo "failed: ${{failed}}"

        if [[ "$failed" != "0" ]]; then
            echo "ERROR: Stage1 summary indicates FAILED: 0"
            exit 1
        fi

        echo "Stage1 completed successfully"
        touch {output.done}
        """


# ---------------------------------------
# 2) Compact Stage-1 Outputs
# ---------------------------------------
rule stage1Compact:
    input:
        STATEDIR + f"/stage1_{{year}}_rep{FINAL_REP}.done"
    output:
        done=STATEDIR + "/stage1_compact_{year}.done",
    log:
        LOGDIR + "/stage1_compact_{year}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
        outpath=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}"
        ),           
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m compact \
            {params.gw} \
            > {log} 2>&1

        # -----------------------------
        # Validation block
        # -----------------------------
        BASE="{params.outpath}"
        DIR_F1="$BASE/f1_0"
        DIR_CMP="$BASE/compacted"

        echo "Checking compact consistency..."

        fail_flag=0

        for sample in $(ls "$DIR_F1"); do
            f1_dir="$DIR_F1/$sample"
            cmp_dir="$DIR_CMP/$sample"

            # --- Check existence ---
            if [[ ! -d "$cmp_dir" ]]; then
                echo "Missing compacted sample: $sample"
                fail_flag=1
                continue
            fi

            # --- Size comparison (in bytes, robust) ---
            size_f1=$(du -sb "$f1_dir" | awk '{{print $1}}')
            size_cmp=$(du -sb "$cmp_dir" | awk '{{print $1}}')

            # allow small tolerance (important!)
            ratio=$(awk "BEGIN {{print $size_cmp / $size_f1}}")

            echo "$sample : f1=$size_f1 cmp=$size_cmp ratio=$ratio"

            # allow up to 20% shrink (very safe)
            if (( $(awk "BEGIN {{print ($ratio < 0.8)}}") )); then
                echo "Size mismatch for $sample → deleting compacted"
                rm -rf "$cmp_dir"
                fail_flag=1
            fi

            # --- Check parquet existence ---
            if ! find "$cmp_dir/0" -name "*.parquet" | grep -q .; then
                echo "No parquet found in $sample"
                rm -rf "$cmp_dir"
                fail_flag=1
            fi
        done

        # --- Final decision ---
        if [[ "$fail_flag" -ne 0 ]]; then
            echo "ERROR: Compact validation failed"
            exit 1
        fi

        echo "Compact validation passed"
        touch {output.done}
        """


# ---------------------------------------
# 3) Plotter (depends on stage1 outputs)
# ---------------------------------------
rule plots:
    input:
        lambda wc: [] if USE_EXISTING_STAGE1 else [
            STATEDIR + f"/stage1_compact_{wc.year}.done"
        ]       
    output:
        done=STATEDIR + "/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.done",
    log:
        LOGDIR + "/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        gw=lambda wc: gw_flags_plots(),
        load_path=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}/f1_0"
        ),        
        save_path=lambda wc: (
            f"validation/figs/Run3_nanoAODv{nano_for_year(wc.year)}/"
            f"{label_for_year(wc.year)}/VBFfilter_False/"
        ),
        # map wildcards -> CLI flags
        zpt_flag=lambda wc: "--remove_zpt_weights" if wc.zpt_mode == "nozpt" else "",
        minset_flag=lambda wc: "--minimum_set" if wc.var_set == "minset" else ""
    # resources:
    #     gateway=1
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}

        PYTHONUNBUFFERED=1 \
        python plotter/validation_plotter_unified.py \
            -y {wildcards.year} \
            --save_path {params.save_path} \
            --load {params.load_path} \
            --use-compacted "compacted" \
            -cat {wildcards.cat} \
            {params.gw} \
            --njets {wildcards.njets_plot} \
            --jj-eta-region "{wildcards.jj_eta_region}" \
            --region h-sidebands z-peak \
            {params.minset_flag} \
            {params.zpt_flag} \
            > {log} 2>&1

        # ---- SUCCESS CHECK ----
        if grep -q "Plots are saved to " {log}; then
            echo "Plot job successful."
            touch {output.done}
        else
            echo "ERROR: Plot job did not complete successfully."
            echo "Success string not found in log."
            exit 1
        fi
        """

