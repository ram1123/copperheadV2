# ---------------------------------------
# 8) After we have all preliminary correction
# ---------------------------------------
rule corrections_ready:
    input:
        "state/zpt_step2_{year}_{njets}.done",
        "state/mass_calibration_Data_{year}.done",
        "state/mass_calibration_MC_{year}.done",
    output:
        "state/corrections_ready_{year}.done",
    shell:
        r"""
        mkdir -p state
        touch {output}
        """


