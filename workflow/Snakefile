    raise ValueError("jj_combine_regions: jj_non_central overlaps the forward regions (double-counting)")
JJ_COMBINED_NAME = "jj_combined" + "".join("_" + r.removeprefix("jj_") for r in JJ_COMBINE_REGIONS)  # = common_workflow.sh jj_combined_name()


def jj_tag(region):
    return "" if region == "all" else f"_{region}"


def jj_env(jjtag):
    return f"JJ_ETA_REGION={jjtag[1:]} " if jjtag else ""


