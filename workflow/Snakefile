PLOT_NJETS = ["inclusive"]   # adapt to what your script accepts

JJ_ETA_REGIONS = [
    "all",
    "jj_both_central",
    # "jj_non_central",
    # "jj_one_fwd25_one_central",
    # "jj_one_he_one_central",
    # "jj_one_fwd30_one_central",
    # "jj_both_fwd25",
    # "jj_both_he",
    # "jj_both_fwd30",
    # "jj_one_he_one_fwd30",
]
PLOT_ZPT_MODES  = ["nozpt"] # ["withzpt", "nozpt"]
# PLOT_ZPT_MODES  = ["withzpt", "nozpt"] # ["withzpt", "nozpt"]
PLOT_VAR_SETS   = ["fullset"]          # ["minset", "fullset"]

wildcard_constraints:
    year="|".join([str(y) for y in YEARS]),
    rep="|".join(REPEATS),
    cat="|".join(PLOT_CATS),
    njets="|".join(ZPT_JETS_CATS),
    njets_plot = "|".join(PLOT_NJETS),
    zpt_mode   = "|".join(PLOT_ZPT_MODES),
    var_set    = "|".join(PLOT_VAR_SETS),
    jj_eta_region = "|".join(JJ_ETA_REGIONS),

RUN2_YEARS = ["2016preVFP", "2016postVFP", "2017", "2018"]
RUN3_YEARS = ["2022preEE", "2022postEE", "2023", "2023BPix", "2024", "2025"]
YEAR_META = {
    "2016preVFP": ("run2", "15"),
    "2016postVFP": ("run2", "15"),
    "2017": ("run2", "15"),
    "2018": ("run2", "15"),
    "2022preEE": ("run3", "12"),
    "2022postEE": ("run3", "12"),
    "2023": ("run3", "12"),
    "2023BPix": ("run3", "12"),
    "2024": ("run3", "15"),
    "2025": ("run3", "15"),
}

DATASET_YAMLS = {
    ("run2", "12"): "configs/datasets/dataset_nanoAODv12_run2.yaml",
    ("run2", "15"): "configs/datasets/dataset_nanoAODv15_run2.yaml",
    ("run3", "15"): "configs/datasets/dataset_nanoAODv15_run3.yaml",
    ("run3", "12"): "configs/datasets/dataset_nanoAODv12_run3.yaml",
}


def nano_for_year(year: str) -> str:
    try:
        return YEAR_META[year][1]
    except KeyError as e:
        raise ValueError(f"nano_for_year: unknown year '{year}'") from e


def yaml_for_year(year: str) -> str:
    try:
        era, nano = YEAR_META[year]
    except KeyError as e:
        raise ValueError(f"yaml_for_year: unknown year '{year}'") from e

    try:
        return DATASET_YAMLS[(era, nano)]
    except KeyError as e:
        raise ValueError(
            f"No dataset YAML for era={era}, nano={nano} (year={year})"
        ) from e


def label_for_year(year: str) -> str:
    era, nano = YEAR_META[year]
    # nano = "12"
    era_tag = "Run2" if era == "run2" else "Run3"
    return f"{era_tag}_nanoAODv{nano}_{RUN_TAG}"


def plot_base_for_year(year: str) -> str:
    era, nano = YEAR_META[year]
    # nano = "12"
    era_tag = "Run2" if era == "run2" else "Run3"
    return f"validation/figs/{era_tag}_nanoAODv{nano}"


USE_GW = bool(config.get("use_gateway", False))
CLIDX  = str(config.get("cluster_index", 0))

ZPT = config["zpt"]
ZPT_OUT = ZPT.get("outbase", "try_zpt_dnn")
ZPT_MAXEV = int(ZPT.get("max_events", 3000000))
ZPT_BATCH = int(ZPT.get("batch", 65536))


def gw_flags():
    return f"-k -i {CLIDX}" if USE_GW else ""


def gw_flags_plots():
    return f" --use_gateway --cluster_index {CLIDX} " if USE_GW else ""

PLOT_TARGETS = [
    (year, cat, njets_plot, jj_eta_region, zpt_mode, var_set)
    for year in YEARS
    for cat in PLOT_CATS
    for njets_plot in PLOT_NJETS
    for jj_eta_region in JJ_ETA_REGIONS
    for zpt_mode in PLOT_ZPT_MODES
    for var_set in PLOT_VAR_SETS
    if not (cat == "vbf" and njets_plot != "inclusive")
]
PLOT_DONE = expand(
    STATEDIR + "/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.done",
    zip,
    year=[x[0] for x in PLOT_TARGETS],
    cat=[x[1] for x in PLOT_TARGETS],
    njets_plot=[x[2] for x in PLOT_TARGETS],
    jj_eta_region=[x[3] for x in PLOT_TARGETS],
    zpt_mode=[x[4] for x in PLOT_TARGETS],
    var_set=[x[5] for x in PLOT_TARGETS],
)

