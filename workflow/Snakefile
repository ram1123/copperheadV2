        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(RUN3_PLOT_YEARS[0]),
        yaml=lambda wc: yaml_for_year(RUN3_PLOT_YEARS[0]),
        label=lambda wc: stage23_label(RUN3_PLOT_YEARS[0]),
        years=",".join(RUN3_PLOT_YEARS),
        var_env=VARIATIONS_ENV,
        postfix=SAVE_POSTFIX,
        jj_env=lambda wc: jj_env(wc.jjtag),
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {params.jj_env}{params.var_env}PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{params.years}" \
            -m 2p \
            -o {params.postfix} \
            > {log} 2>&1

        echo "{rule} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


# Mandatory stage-3 template check before any fit: one plot per nuisance + CSV under
# validation/stage3_templates/<label>/<postfix>[_<region>]/, and it fails the job on
# non-finite or negative template bins (scripts/plot_template_systematics.py).
rule stage3_validate:
    input:
        STATEDIR + "/stage3_{year}{jjtag}.done",
    output:
        done=STATEDIR + "/stage3_validate_{year}{jjtag}.done",
    log:
        LOGDIR + "/stage3_validate_{year}{jjtag}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        tmpl_dir=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/{stage23_label(wc.year)}/"
            f"stage3_datacards_{SAVE_POSTFIX}{wc.jjtag}/stage3_templates_{SAVE_POSTFIX}{wc.jjtag}/"
            f"score_{stage23_label(wc.year)}"
        ),
        val_dir=lambda wc: (
            f"validation/stage3_templates/{stage23_label(wc.year)}/{SAVE_POSTFIX}{wc.jjtag}"
        ),
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {{
        PYTHONPATH="$PWD:${{PYTHONPATH:-}}" PYTHONUNBUFFERED=1 python scripts/plot_template_systematics.py \
            -i {params.tmpl_dir} -o {params.val_dir}/template_systematics/{wildcards.year} \
            --years {wildcards.year}
        PYTHONPATH="$PWD:${{PYTHONPATH:-}}" PYTHONUNBUFFERED=1 python scripts/plot_template_negative_bins.py \
            -i {params.tmpl_dir} -o {params.val_dir}/templates_nominal_{wildcards.year}.pdf \
            -t "{wildcards.year}{wildcards.jjtag}" --years {wildcards.year}
        }} > {log} 2>&1

        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


rule stage23_all:
    input:
        expand(STATEDIR + "/stage2_plot_{year}{jjtag}.done", year=YEARS, jjtag=STAGE23_JJ_TAGS),
        expand(STATEDIR + "/stage3_{year}{jjtag}.done", year=YEARS + STAGE3_EXTRA_YEARS, jjtag=STAGE23_JJ_TAGS),
        expand(STATEDIR + "/stage3_validate_{year}{jjtag}.done", year=YEARS + STAGE3_EXTRA_YEARS, jjtag=STAGE23_JJ_TAGS),
        # only meaningful with more than one Run 3 year
        expand(STATEDIR + "/stage2_plot_Run3{jjtag}.done", jjtag=STAGE23_JJ_TAGS) if len(RUN3_PLOT_YEARS) > 1 else [],


# ---------------------------------------
# Stats on the validated stage-3 cards (same steps as scripts/run_jj_region_scan.sh), run in the
# `combine` pixi env through ./run_in_pixi.sh while snakemake itself stays in `default`:
#   stats             run_stats_pipeline_VBF.sh -m 11 (card+workspace+significance+expected limit), per region
#   stats_jj_combined -m 12, jj_combine_regions combined into one multi-channel card
#   impacts/lhscan    -m 7/8 per region, -m 13/14 on the combination (blinded Asimov), scan_years only
# One job per region covers all stats_years: the summary CSVs are rebuilt from every year's logs,
# so per-year jobs in one card dir would race. Not in `rule all`; request stats_all, e.g.
#   snakemake -s workflow/Snakefile stats_all -j 3 --resources gateway=1 --rerun-incomplete --restart-times 3 --latency-wait 60 \
#       --config run_tag=<tag> stage23_standalone=True with_variations=True save_postfix=Oct05_2026_Syst_RegBins \
#       stage23_label=Run3_nanoAODv15_<tag> \
#       'jj_eta_regions=[all,jj_both_central,jj_one_fwd25_one_central,jj_both_fwd25]' \
#       'jj_combine_regions=[jj_both_central,jj_one_fwd25_one_central,jj_both_fwd25]'
# ---------------------------------------
STAGE3_YEARS = YEARS + STAGE3_EXTRA_YEARS
# Per-year cards each pseudo-year combines (= common_workflow.sh ensure_vbf_card).
STATS_PSEUDO_YEARS = {"Run3": ("2022preEE", "2022postEE", "2023", "2023BPix", "2024", "2025_2026")}
STATS_YEARS = config.get("stats_years") or STAGE3_YEARS + [
    p for p, comps in STATS_PSEUDO_YEARS.items() if all(c in STAGE3_YEARS for c in comps)
]
# Years/pseudo-years for impacts + likelihood scans (expensive); default Run3 when it is in stats_years.
SCAN_YEARS = config.get("scan_years") or [y for y in ("Run3",) if y in STATS_YEARS]
RUN_IMPACTS = bool(config.get("run_impacts", True)) and bool(SCAN_YEARS)
RUN_LHSCAN = bool(config.get("run_lhscan", True)) and bool(SCAN_YEARS)
JJ_COMBINE_ENV = f"JJ_COMBINE_REGIONS={','.join(JJ_COMBINE_REGIONS)} "


def stats_label():
    """The one label every stats year's cards live under (the Run3 card combines them)."""
    labels = {stage23_label(y) for y in STAGE3_YEARS}
    if len(labels) != 1:
        raise ValueError(
            f"stats rules need one label for all stage-3 years, got {sorted(labels)}; "
            "set stage23_label in workflow/config.yaml"
        )
    return labels.pop()


STATS_PARAMS = dict(
    logdir=LOGDIR,
    statedir=STATEDIR,
    postfix=SAVE_POSTFIX,
    stats_years=",".join(STATS_YEARS),
    scan_years=",".join(SCAN_YEARS),
)


rule stats:
    input:
        lambda wc: expand(STATEDIR + "/stage3_validate_{year}" + wc.jjtag + ".done", year=STAGE3_YEARS),
    output:
        done=STATEDIR + "/stats{jjtag}.done",
    log:
        LOGDIR + "/stats{jjtag}.log",
    params:
        **STATS_PARAMS,
        label=lambda wc: stats_label(),
        jj_env=lambda wc: jj_env(wc.jjtag),
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {params.jj_env}./run_in_pixi.sh combine bash run_stats_pipeline_VBF.sh \
            -m 11 -y {params.stats_years} -l {params.label} -o {params.postfix} \
            > {log} 2>&1

        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


rule stats_jj_combined:
    input:
        expand(STATEDIR + "/stats{jjtag}.done", jjtag=[jj_tag(r) for r in JJ_COMBINE_REGIONS]),
    output:
        done=STATEDIR + f"/stats_{JJ_COMBINED_NAME}.done",
    log:
        LOGDIR + f"/stats_{JJ_COMBINED_NAME}.log",
    params:
        **STATS_PARAMS,
        label=lambda wc: stats_label(),
        combine_env=JJ_COMBINE_ENV,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {params.combine_env}./run_in_pixi.sh combine bash run_stats_pipeline_VBF.sh \
            -m 12 -y {params.stats_years} -l {params.label} -o {params.postfix} \
            > {log} 2>&1

        echo "{rule} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


# Blinded impacts (Asimov r=1 and r=0) and 1D likelihood scan (Asimov r=1) per region.
