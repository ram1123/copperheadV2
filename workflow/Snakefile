        # (2) stage1Compact for all years
        INITIAL_STAGE1_COMPACT_DONE,


# ---------------------------------------
# 1) Stage-1 (all samples)
# ---------------------------------------
rule stage1:
    output:
        done=STATEDIR + "/stage1_{year}_rep{rep}.done",
    log:
        LOGDIR + "/stage1_{year}_rep{rep}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
        switches=lambda wc: switches_flag(),
        summary=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}/"
            "_status/stage1_summary.log"
        ),
        prestage_env=PRESTAGE_ENV,
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        ts=$(date +"%Y-%m-%d_%H-%M-%S")
        {params.prestage_env}PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m 1 -Z \
          {params.gw}  \
          {params.switches}  \
          > {log} 2>&1
        summary="{params.summary}"

        # Rename log file after running the command, as Snakemake
        # delets the log file before running the command.
        LOGFILE="{log}"
        if [[ -f "$LOGFILE" ]]; then
            echo "Rotating existing log → $LOGFILE.attempt_${{ts}}"
            cp "$LOGFILE" "$LOGFILE.attempt_${{ts}}"
        else
            echo "No previous log found (first run)"
        fi

        if [[ ! -f "$summary" ]]; then
            echo "ERROR: stage1 summary log not found: $summary"
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            exit 1
        fi

        failed=$(sed -n '2p' "$summary" | awk '{{print $4}}' )
        echo "failed: ${{failed}}"

        if [[ "$failed" != "0" ]]; then
            echo "ERROR: Stage1 summary indicates FAILED count: ${{failed}}"
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            exit 1
        fi

        echo "Stage1 completed successfully"
        echo "{rule} {wildcards} SUCCESS attempt time stamp: ${{ts}}" >> {FAIL_LOG}
        touch {output.done}
        """


# ---------------------------------------
# 2) Compact Stage-1 Outputs
# ---------------------------------------
rule stage1Compact:
    input:
        STATEDIR + f"/stage1_{{year}}_rep{FINAL_REP}.done"
    output:
        done=STATEDIR + "/stage1_compact_{year}.done",
    log:
        LOGDIR + "/stage1_compact_{year}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
        outpath=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}"
        ),
        cleanup_f1_0="1" if CLEANUP_F1_0_AFTER_COMPACT else "0",
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m compact \
            {params.gw} \
            > {log} 2>&1

        # -----------------------------
        # Validation block
        # -----------------------------
        BASE="{params.outpath}"
        if ! python3 scripts/compact_sanity_check.py --base "$BASE"; then
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            echo "stage1Compact year={wildcards.year} attempt= FAILED" >> {FAIL_LOG}
            exit 1
        fi

        # -----------------------------
        # Optional cleanup: once compact_sanity_check.py above has confirmed
        # every sample's compacted output matches f1_0 (row counts/sizes),
        # f1_0 is a fully-redundant duplicate of data now safely held in
        # compacted/ -- opt-in via cleanup_f1_0_after_compact in config.yaml
        # since this is irreversible (f1_0 is otherwise never deleted).
        # -----------------------------
        if [[ "{params.cleanup_f1_0}" == "1" ]]; then
            # never delete cutflow shards that were not saved outside f1_0 (run_cutflow_merge, -m compact)
            if find "$BASE/f1_0" -name 'cutflow_*.npz' -print -quit 2>/dev/null | grep -q . \
                    && ! ls "$BASE"/cutflow/cutflow_merged_*.json > /dev/null 2>&1; then
                echo "ERROR: $BASE/f1_0 has cutflow shards but $BASE/cutflow/ has no merged cutflow; not deleting f1_0"
                echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
                exit 1
            fi
            echo "cleanup_f1_0_after_compact enabled; removing $BASE/f1_0"
            rm -rf "$BASE/f1_0"
        fi

        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


# ---------------------------------------
# 2b) PU-DNN training (jet-level HS-vs-PU classifier consumed back inside a
# LATER stage1 run via do_use_pu_dnn_score/pu_dnn_model_dir -- not to be
# confused with the VBF-category DNN, which trains on stage2 output).
# Not wired into `rule all` (see the commented-out target below): this is a
# deliberate, occasional retraining step, not something that should fire as
# a side effect of a routine `snakemake ... all_stage1` run. Request it
# explicitly, e.g.:
#   snakemake -s workflow/Snakefile state/<run_tag>/pu_dnn_train_<year>.done
# ---------------------------------------
rule pu_dnn_train:
    input:
        lambda wc: [] if USE_EXISTING_STAGE1 else [
            STATEDIR + f"/stage1_compact_{wc.year}.done"
        ]
    output:
        done=STATEDIR + "/pu_dnn_train_{year}.done",
    log:
        LOGDIR + "/pu_dnn_train_{year}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        label=lambda wc: label_for_year(wc.year),
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m pu_dnn_train \
            > {log} 2>&1

        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


# ---------------------------------------
# 2c) VBF-category DNN (preprocess -> HPO -> train). Combines all years in
# DNN_YEARS into one invocation each (mirrors run_dnn_workflow_once in
# common_workflow.sh, which is keyed off -y's full year list, not a single
# year) -- so these rules carry no {year} wildcard. Not wired into `rule all`
# (see rule vbf_dnn below): training a new VBF DNN is a deliberate step, not
# something that should fire as a side effect of a routine stage1/plot run.
# Request explicitly, e.g.:
#   snakemake -s workflow/Snakefile state/<run_tag>/dnn_train.done
# ---------------------------------------
DNN_CONFIG = config.get("dnn_config", "configs/dnn_run3_vbf.yaml")
DNN_YEARS = config.get("dnn_years", YEARS)
DNN_YEARS_CSV = ",".join(DNN_YEARS)
DNN_JJ_ETA_REGION = config.get("dnn_jj_eta_region", None)


def dnn_env_flags():
    return f"JJ_ETA_REGION={DNN_JJ_ETA_REGION} " if DNN_JJ_ETA_REGION else ""


rule dnn_pre:
    input:
        [] if USE_EXISTING_STAGE1 else expand(STATEDIR + "/stage1_compact_{year}.done", year=DNN_YEARS),
    output:
        done=STATEDIR + "/dnn_pre.done",
    log:
        LOGDIR + "/dnn_pre.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        env=dnn_env_flags(),
        config=DNN_CONFIG,
        years=DNN_YEARS_CSV,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {params.env}DNN_CONFIG={params.config} PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -y "{params.years}" \
            -m dnn_pre \
            > {log} 2>&1

        echo "{rule} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


rule dnn_hpo:
    input:
        STATEDIR + "/dnn_pre.done",
    output:
        done=STATEDIR + "/dnn_hpo.done",
    log:
        LOGDIR + "/dnn_hpo.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        env=dnn_env_flags(),
        config=DNN_CONFIG,
        years=DNN_YEARS_CSV,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        {params.env}DNN_CONFIG={params.config} PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -y "{params.years}" \
            -m dnn_hpo \
            > {log} 2>&1

        echo "{rule} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


