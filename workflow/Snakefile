# Stage-2 DNN data/MC plot summed over all Run 3 years in YEARS (the per-year stage2_plot jobs
# each see one year only). Reruns -m 2p over those years; the per-year plots it redoes are cheap.
RUN3_PLOT_YEARS = [
    y for y in YEARS
    if y in ("2022preEE", "2022postEE", "2023", "2023BPix", "2024", "2025", "2026")
]


