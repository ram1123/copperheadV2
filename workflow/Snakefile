# Per-category njets_plot bins to produce for non-vbf categories (vbf is
# always njets_plot="2" by construction, see _jet_region_targets_for below).
# Maps category name -> list of "inclusive"/"0"/"1"/"2" values wanted; a
# category in plot_categories but absent here defaults to ["inclusive"].
PLOT_NJETS_PLOTS = config.get("plot_njets_plots", {})

# Suffix appended to the plot output directory name (label_for_year(year) +
# suffix) -- lets you rerun the plotter under the same run_tag with different
# settings so that it won't overwrite the old plots.
PLOT_OUTPUT_SUFFIX = config.get("plot_output_suffix", "_DY_ReRun")


def _jet_region_targets_for(cat):
    """
    (njets_plot, jj_eta_region) pairs to generate for one category. vbf's own
    category cut (jj_mass/jj_dEta need two real jets, see applyRegionCatCuts)
    already requires njets>=2 by construction, so it always gets just the
    pair-based jj_eta_region matrix, explicitly labeled njets_plot="2" (not
    "inclusive" -- vbf-tagged events are never anything but >=2-jet).

    Non-vbf categories (ggh/nocat) pick their njets_plot bins from
    PLOT_NJETS_PLOTS[cat] (plot_njets_plots in config.yaml), defaulting to
    ["inclusive"] if the category isn't listed there -- e.g. ["0"] for only
    the zero-jet bin, ["inclusive"] for only the plain overview, or
    ["0", "1", "2"] for the full njets multiplicity split. "1" further splits
    by plot_single_jet_eta_regions if set (else just "all"); "2" splits by
    plot_jj_eta_regions, same as vbf.
    """
    if cat == "vbf":
        return [("2", r) for r in JJ_ETA_REGIONS]

    targets = []
    for njets_plot in PLOT_NJETS_PLOTS.get(cat, ["inclusive"]):
        if njets_plot == "inclusive":
            targets.append(("inclusive", "all"))
        elif njets_plot == "0":
            targets.append(("0", "all"))
        elif njets_plot == "1":
            targets += [("1", r) for r in (SINGLE_JET_ETA_REGIONS or ["all"])]
        elif njets_plot == "2":
            targets += [("2", r) for r in JJ_ETA_REGIONS]
        else:
            raise ValueError(
                f"_jet_region_targets_for: unknown njets_plot '{njets_plot}' for "
                f"cat '{cat}' (see plot_njets_plots in workflow/config.yaml)"
            )
    return targets


# All njets_plot values actually produced by _jet_region_targets_for() above
# for the configured PLOT_CATS -- derived, not hand-maintained, so it can
# never drift out of sync with the target generator the way a separately
# hardcoded list did before (root cause of a MissingInputException hit twice
# this development cycle).
PLOT_NJETS = sorted({njets_plot for cat in PLOT_CATS for njets_plot, _ in _jet_region_targets_for(cat)})

wildcard_constraints:
    year="|".join([str(y) for y in YEARS + STAGE3_EXTRA_YEARS]),
    rep="|".join(REPEATS),
    cat="|".join(PLOT_CATS),
    njets="|".join(ZPT_JETS_CATS),
    njets_plot = "|".join(PLOT_NJETS),
    zpt_mode   = "|".join(PLOT_ZPT_MODES),
    var_set    = "|".join(PLOT_VAR_SETS),
    jj_eta_region = "|".join(JJ_ETA_REGIONS + SINGLE_JET_ETA_REGIONS),
    # optional group: Snakemake only matches the empty ("all") tag this way, not via a bare "" alternative
    jjtag = "(?:" + "|".join(sorted({jj_tag(r) for r in STAGE23_JJ_ETA_REGIONS + JJ_COMBINE_REGIONS} - {""})) + ")?",

RUN2_YEARS = ["2016preVFP", "2016postVFP", "2017", "2018"]
RUN3_YEARS = ["2022preEE", "2022postEE", "2023", "2023BPix", "2024", "2025"]
YEAR_META = {
    "2016preVFP": ("run2", "15"),
    "2016postVFP": ("run2", "15"),
    "2017": ("run2", "15"),
    "2018": ("run2", "15"),
    "2022preEE": ("run3", "12"),
    "2022postEE": ("run3", "12"),
    "2023": ("run3", "12"),
    "2023BPix": ("run3", "12"),
    "2024": ("run3", "15"),
    "2025": ("run3", "15"),
    "2026": ("run3", "15"),
    "2025_2026": ("run3", "15"),
}

DATASET_YAMLS = {
    ("run2", "12"): "configs/datasets/dataset_nanoAODv12_run2.yaml",
    ("run2", "15"): "configs/datasets/dataset_nanoAODv15_run2.yaml",
    ("run3", "15"): "configs/datasets/dataset_nanoAODv15_run3.yaml",
    ("run3", "12"): "configs/datasets/dataset_nanoAODv12_run3.yaml",
}


def nano_for_year(year: str) -> str:
    try:
        return YEAR_META[year][1]
    except KeyError as e:
        raise ValueError(f"nano_for_year: unknown year '{year}'") from e


def yaml_for_year(year: str) -> str:
    try:
        era, nano = YEAR_META[year]
    except KeyError as e:
        raise ValueError(f"yaml_for_year: unknown year '{year}'") from e

    try:
        return DATASET_YAMLS[(era, nano)]
    except KeyError as e:
        raise ValueError(
            f"No dataset YAML for era={era}, nano={nano} (year={year})"
        ) from e


def label_for_year(year: str) -> str:
    era, nano = YEAR_META[year]
    # nano = "12"
    era_tag = "Run2" if era == "run2" else "Run3"
    return f"{era_tag}_nanoAODv{nano}_{RUN_TAG}"


# One label for every year's stage2/stage2_plot/stage3/stats (e.g. a v15 label whose stage1_output
# symlinks the v12 2022-2023 years); "" = label_for_year(year). The Run3 stats card needs one label.
STAGE23_LABEL = config.get("stage23_label") or ""


def stage23_label(year: str) -> str:
    return STAGE23_LABEL or label_for_year(year)


def plot_base_for_year(year: str) -> str:
    era, nano = YEAR_META[year]
    # nano = "12"
    era_tag = "Run2" if era == "run2" else "Run3"
    return f"validation/figs/{era_tag}_nanoAODv{nano}"


