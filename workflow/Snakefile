rule stage1Compact_corr:
    input:
       STATEDIR + "/stage1_corr_{year}.done",
    output:
        done=STATEDIR + "/stage1_compact_corr_{year}.done",
    log:
        LOGDIR + "/stage1_compact_corr_{year}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m compact \
          {params.gw} \
          > {log} 2>&1
        touch {output.done}
        """


rule plots_corr:
    input:
       STATEDIR + "/stage1_compact_corr_{year}.done",
    output:
        done=STATEDIR + "/plots_corr_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.done",
    log:
        LOGDIR + "/plots_corr_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        gw=lambda wc: gw_flags_plots(),
        load_path=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}/f1_0"
        ),        
        save_path=lambda wc: (
            f"validation/figs/Run3_nanoAODv{nano_for_year(wc.year)}/"
            f"{label_for_year(wc.year)}/VBFfilter_False/"
        ),
        # map wildcards -> CLI flags
        zpt_flag=lambda wc: "--remove_zpt_weights" if wc.zpt_mode == "nozpt" else "",
        minset_flag=lambda wc: "--minimum_set" if wc.var_set == "minset" else ""        
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 \
        python plotter/validation_plotter_unified.py \
            -y {wildcards.year} \
            --save_path {params.save_path} \
            --load {params.load_path} \
            --use-compacted "compacted" \
            -cat {wildcards.cat} \
            {params.gw} \
            --njets {wildcards.njets_plot} \
            --jj-eta-region "{wildcards.jj_eta_region}" \
            --region h-sidebands z-peak \
            {params.minset_flag} \
            {params.zpt_flag} \
            > {log} 2>&1

        # ---- SUCCESS CHECK ----
        if grep -q "Plots are saved to " {log}; then
            echo "Plot job successful."
            touch {output.done}
        else
            echo "ERROR: Plot job did not complete successfully."
            echo "Success string not found in log."
            exit 1
        fi
        """


# ---------------------------------------
# 7) ZpT DNN trainings (3 bins) per year
# Depends on stage1 because it uses stage1 outputs.
# ---------------------------------------
rule zpt_njet0:
    input:
       STATEDIR + "/stage1_compact_{year}.done",
    output:
        done=STATEDIR + "/zpt_wgt_{year}_njet0.done",
    log:
        LOGDIR + "/zpt_wgt_{year}_njet0.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        python MVA_training/zpt_reweight/train_dnn_zpt_reweight_dak.py \
          -y {wildcards.year} \
          --outdir {ZPT_OUT}/{ZPT_TAG}/{wildcards.year}/njet0 \
          --njet-bin 0 \
          --max-events {ZPT_MAXEV} \
          --batch {ZPT_BATCH} \
          > {log} 2>&1
        touch {output.done}
        """


