        """


# ---------------------------------------
# 6) ZpT weight computation (stage-2: Run the final polyfit and obtain final function parameters and save it in YAML file) (depends on zpt1 outputs)
# ---------------------------------------
rule zpt2:
    input:
       STATEDIR + "/zpt_step1_{year}_njets{njets}.done",
    output:
        done=STATEDIR + "/zpt_step2_{year}_njets{njets}.done",
    log:
        LOGDIR + "/zpt_step2_{year}_njets{njets}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m zpt_fit2 \
          -n {wildcards.njets} \
          {params.gw} \
          > {log} 2>&1
        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


# ---------------------------------------
