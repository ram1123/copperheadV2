rule summary:
    input:
        INITIAL_STAGE1_DONE,
        INITIAL_STAGE1_COMPACT_DONE,
        expand(STATEDIR + "/zpt_step0_{year}.done", year=YEARS),
        #expand(STATEDIR + "/mass_calibration_Data_{year}.done", year=YEARS),
    output:
        f"{STATEDIR}/summary.done"
    shell:
        r"""
        echo "=============================="
        echo " FINAL JOB SUMMARY"
        echo "=============================="

        if [[ -f {FAIL_LOG} ]]; then
            echo ""
            echo "FAILED JOBS:"
            cat {FAIL_LOG} | grep FAILED || true

            nfail=$(grep -c FAILED {FAIL_LOG} || true)
        else
            nfail=0
        fi

        nsuccess=$(grep -c SUCCESS {FAIL_LOG} || true)

        echo ""
        echo "SUCCESS: $nsuccess"
        echo "FAILED:  $nfail"

        if [[ "$nfail" -ne 0 ]]; then
            echo "Some jobs failed"
            exit 1
        else
            echo "All jobs successful"
        fi

        touch {output}
        """
