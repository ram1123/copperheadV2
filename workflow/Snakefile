import os

configfile: "workflow/config.yaml"

YEARS = config["years"]
SUFFIX = config["label_suffix"]
PLOT_CATS = ["nocat", "vbf", "ggh"]
ZPT_JETS_CATS = ["0", "1", "2"]

wildcard_constraints:
    year = "|".join([str(y) for y in YEARS]),
    cat = "|".join(PLOT_CATS),
    njets = "|".join(ZPT_JETS_CATS)

RUN2_YEARS = ["2016preVFP", "2016postVFP", "2017", "2018"]
RUN3_YEARS = ["2022preEE", "2022postEE", "2023", "2023BPix", "2024", "2025"]
YEAR_META = {
    "2016preVFP": ("run2", "15"),
    "2016postVFP": ("run2", "15"),
    "2017": ("run2", "15"),
    "2018": ("run2", "15"),

    "2022preEE": ("run3", "12"),
    "2022postEE": ("run3", "12"),
    "2023": ("run3", "12"),
    "2023BPix": ("run3", "12"),
    "2024": ("run3", "15"),
}

DATASET_YAMLS = {
    ("run2", "15"): "configs/datasets/dataset_nanoAODv15_run2.yaml",
    ("run3", "15"): "configs/datasets/dataset_nanoAODv15_run3.yaml",
    ("run3", "12"): "configs/datasets/dataset_nanoAODv12_run3.yaml",
}

def nano_for_year(year: str) -> str:
    try:
        return YEAR_META[year][1]
    except KeyError as e:
        raise ValueError(f"nano_for_year: unknown year '{year}'") from e

def yaml_for_year(year: str) -> str:
    try:
        era, nano = YEAR_META[year]
    except KeyError as e:
        raise ValueError(f"yaml_for_year: unknown year '{year}'") from e

    try:
        return DATASET_YAMLS[(era, nano)]
    except KeyError as e:
        raise ValueError(f"No dataset YAML for era={era}, nano={nano} (year={year})") from e

def label_for_year(year: str) -> str:
    return f"Run3_nanoAODv{nano_for_year(year)}_{SUFFIX}"

def label_for_year_corr(year: str) -> str:
    """This label is after zpt and EBE correction"""
    return f"{label_for_year(year)}_Corr"   

USE_GW = bool(config.get("use_gateway", False))
# CLIDX  = str(config.get("cluster_index", 0))

ZPT = config["zpt"]
ZPT_TAG   = label_for_year(YEARS[0])  # Use first year's label for ZPT_TAG
ZPT_OUT   = ZPT.get("outbase", "try_zpt_dnn")
ZPT_MAXEV = int(ZPT.get("max_events", 3000000))
ZPT_BATCH = int(ZPT.get("batch", 65536))


def gw_flags():
    return f"-k " if USE_GW else ""

def gw_flags_plots():
    return f" --use_gateway " if USE_GW else ""    

rule all:
    input:
        # (1) stage1 for all years
        expand("state/stage1_{year}.done", year=YEARS),

        # (2) stage1Compact for all years
        expand("state/stage1_compact_{year}.done", year=YEARS),

        # (3) plotter (after stage1)
        expand("state/plots_{year}_{cat}.done", year=YEARS, cat=PLOT_CATS),

        # (4) get zpt
        expand("state/zpt_step0_{year}.done", year=YEARS),
        expand("state/zpt_step1_{year}_{njets}.done", year=YEARS, njets=ZPT_JETS_CATS),
        expand("state/zpt_step2_{year}_{njets}.done", year=YEARS, njets=ZPT_JETS_CATS),

        # (5) get EBE mass calibration
        expand("state/mass_calibration_Data_{year}.done", year=YEARS),
        expand("state/mass_calibration_MC_{year}.done", year=YEARS),
        expand("state/mass_calibration_MC_Closure_{year}.done", year=YEARS),
        expand("state/mass_calibration_Data_Closure_{year}.done", year=YEARS),


        # # (6) second-pass stage1 using latest corrections for zpt and EBE mass calibration
        # expand("state/stage1_corr_{year}.done", year=YEARS),
        # expand("state/stage1_compact_corr_{year}.done", year=YEARS),
        # expand("state/plots_corr_{year}_{cat}.done", year=YEARS, cat=PLOT_CATS),

        # # (4) zpt trainings (after stage1)
        # expand("state/zpt_wgt_{year}_njet0.done", year=YEARS),
        # expand("state/zpt_wgt_{year}_njet1.done", year=YEARS),
        # expand("state/zpt_wgt_{year}_njet2p.done", year=YEARS),

# ---------------------------------------
# 1) Stage-1 (all samples)
# ---------------------------------------
rule stage1:
    output:
        done="state/stage1_{year}.done"
    log:
        "logs/stage1_{year}.log"
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags()
    resources:
        gateway=1
    shell:
        r"""
        set -euo pipefail
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m 1 \
          {params.gw}  \
          > {log} 2>&1
        touch {output.done}
        """
# ---------------------------------------
# 2) Compact Stage-1 Outputs
# ---------------------------------------
rule stage1Compact:
    input:
        "state/stage1_{year}.done"
    output:
        done="state/stage1_compact_{year}.done"
    log:
        "logs/stage1_compact_{year}.log"
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags()
    resources:
        gateway=1        
    shell:
        r"""
        set -euo pipefail
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m compact \
            {params.gw} \
            > {log} 2>&1
        touch {output.done}
        """

# ---------------------------------------
# 3) Plotter (depends on stage1 outputs)
# ---------------------------------------
rule plots:
    input:
        "state/stage1_{year}.done"
    output:
        done="state/plots_{year}_{cat}.done"
    log:
        "logs/plots_{year}_{cat}.log"
    params:
        nano=lambda wc: nano_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags_plots(),
        # where stage1 output lives (your stage1 creates stage1_output/<year>/f1_0)
        load_path=lambda wc: f"/depot/cms/hmm/{os.environ['USER']}/hmm_ntuples/copperheadV1clean/{label_for_year(wc.year)}/stage1_output/{wc.year}/f1_0",
        # where to save plots (make it versioned)
        save_path=lambda wc: f"validation/figs/Run3_nanoAODv{nano_for_year(wc.year)}/{label_for_year(wc.year)}/VBFfilter_False",
    resources:
        gateway=1        
    shell:
        r"""
        set -euo pipefail
        mkdir -p state logs
        PYTHONUNBUFFERED=1 \
        python plotter/validation_plotter_unified.py \
            -y {wildcards.year} \
            --save_path {params.save_path} \
            --load {params.load_path} \
            -cat {wildcards.cat} \
            {params.gw} \
            --njets inclusive \
            --minimum_set \
            --region h-sidebands z-peak \
            --remove_zpt_weights \
            > {log} 2>&1  || true
        touch {output.done}
        """

# ---------------------------------------
# 4) ZpT weight computation (stage-0: Just prepare root files for data/mc for fitting) (depends on stage1 outputs)
# ---------------------------------------
rule zpt0:
    input:
        "state/stage1_compact_{year}.done"
    output:
        done="state/zpt_step0_{year}.done"
    log:
        "logs/zpt_step0_{year}.log"
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags()
    resources:
        gateway=1
    shell:
        r"""
        set -euo pipefail
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m zpt_fit0 \
          > {log} 2>&1
        touch {output.done}
        """
# ---------------------------------------
# 5) ZpT weight computation (stage-1: Run the f-test) (depends on zpt0 outputs)
# ---------------------------------------
rule zpt1:
    input:
        "state/zpt_step0_{year}.done"
    output:
        done="state/zpt_step1_{year}_{njets}.done"
    log:
        "logs/zpt_step1_{year}_{njets}.log"
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags()
    resources:
        gateway=1
    shell:
        r"""
        set -euo pipefail
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m zpt_fit1 \
          -n {wildcards.njets} \
          > {log} 2>&1
        touch {output.done}
        """        

# ---------------------------------------
# 6) ZpT weight computation (stage-2: Run the final polyfit and obtain final function parameters and save it in YAML file) (depends on zpt1 outputs)
# ---------------------------------------
rule zpt2:
    input:
        "state/zpt_step1_{year}_{njets}.done"
    output:
        done="state/zpt_step2_{year}_{njets}.done"
    log:
        "logs/zpt_step2_{year}_{njets}.log"
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags()
    resources:
        gateway=1
    shell:
        r"""
        set -euo pipefail
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m zpt_fit2 \
          -n {wildcards.njets} \
          > {log} 2>&1
        touch {output.done}
        """        

