ZPT_MAXEV = int(ZPT.get("max_events", 3000000))
ZPT_BATCH = int(ZPT.get("batch", 65536))


def gw_flags():
    return f"-k -i {CLIDX}" if USE_GW else ""


def gw_flags_plots():
    return f" --use_gateway --cluster_index {CLIDX} " if USE_GW else ""


