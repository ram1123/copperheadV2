        # f"{STATEDIR}/summary.done"



# ---------------------------------------
# 1) Stage-1 (all samples)
# ---------------------------------------
rule stage1:
    output:
        done=STATEDIR + "/stage1_{year}_rep{rep}.done",
    log:
        LOGDIR + "/stage1_{year}_rep{rep}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
        summary=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}/"
            "_status/stage1_summary.log"
        ),
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        ts=$(date +"%Y-%m-%d_%H-%M-%S")
        PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m 1 \
          {params.gw}  \
          > {log} 2>&1
        summary="{params.summary}"

        # Rename log file after running the command, as Snakemake
        # delets the log file before running the command.
        LOGFILE="{log}"
        if [[ -f "$LOGFILE" ]]; then
            echo "Rotating existing log → $LOGFILE.attempt_${{ts}}"
            cp "$LOGFILE" "$LOGFILE.attempt_${{ts}}"
        else
            echo "No previous log found (first run)"
        fi

        if [[ ! -f "$summary" ]]; then
            echo "ERROR: stage1 summary log not found: $summary"
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            exit 1
        fi

        failed=$(sed -n '2p' "$summary" | awk '{{print $4}}' )
        echo "failed: ${{failed}}"

        if [[ "$failed" != "0" ]]; then
            echo "ERROR: Stage1 summary indicates FAILED count: ${{failed}}"
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            exit 1
        fi

        echo "Stage1 completed successfully"
        echo "{rule} {wildcards} SUCCESS attempt time stamp: ${{ts}}" >> {FAIL_LOG}
        touch {output.done}
        """


# ---------------------------------------
# 2) Compact Stage-1 Outputs
# ---------------------------------------
rule stage1Compact:
    input:
        STATEDIR + f"/stage1_{{year}}_rep{FINAL_REP}.done"
    output:
        done=STATEDIR + "/stage1_compact_{year}.done",
    log:
        LOGDIR + "/stage1_compact_{year}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
        outpath=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}"
        ),
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}
        PYTHONUNBUFFERED=1 bash run_analysis_pipeline.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m compact \
            {params.gw} \
            > {log} 2>&1

        # -----------------------------
        # Validation block
        # -----------------------------
        BASE="{params.outpath}"
        if ! python3 scripts/compact_sanity_check.py --base "$BASE"; then
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            echo "stage1Compact year={wildcards.year} attempt= FAILED" >> {FAIL_LOG}
            exit 1
        fi

        echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
        touch {output.done}
        """


# ---------------------------------------
# 3) Plotter (depends on stage1 outputs)
# ---------------------------------------
rule plots:
    input:
        lambda wc: [] if USE_EXISTING_STAGE1 else [
            STATEDIR + f"/stage1_compact_{wc.year}.done"
        ]
    output:
        done=STATEDIR + "/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.done",
    log:
        LOGDIR + "/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.log",
    params:
        logdir=LOGDIR,
        statedir=STATEDIR,
        gw=lambda wc: gw_flags_plots(),
        load_path=lambda wc: (
            f"{HMM_BASE}/{HMM_USER}/hmm_ntuples/copperheadV1clean/"
            f"{label_for_year(wc.year)}/stage1_output/{wc.year}/f1_0"
        ),
        save_path=lambda wc: (
            f"{plot_base_for_year(wc.year)}/"
            f"{label_for_year(wc.year)}/VBFfilter_False/"
        ),
        # map wildcards -> CLI flags
        zpt_flag=lambda wc: "--remove_zpt_weights" if wc.zpt_mode == "nozpt" else "",
        minset_flag=lambda wc: "--minimum_set" if wc.var_set == "minset" else "",
    # resources:
    #     gateway=1
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p {params.logdir} {params.statedir}

        PYTHONUNBUFFERED=1 \
        python plotter/validation_plotter_unified.py \
            -y {wildcards.year} \
            --save_path {params.save_path} \
            --load {params.load_path} \
            --use-compacted "compacted" \
            -cat {wildcards.cat} \
            {params.gw} \
            --njets {wildcards.njets_plot} \
            --jj-eta-region "{wildcards.jj_eta_region}" \
            --region h-sidebands z-peak \
            {params.minset_flag} \
            {params.zpt_flag} \
            > {log} 2>&1

        #    --use_dnn_zpt_weights \
        #    --vbf_filter_study \

        # ---- SUCCESS CHECK ----
        if grep -q "Plots are saved to " {log}; then
            echo "Plot job successful."
            echo "{rule} {wildcards} SUCCESS attempt=" >> {FAIL_LOG}
            touch {output.done}
        else
            echo "ERROR: Plot job did not complete successfully."
            echo "Success string not found in log."
            echo "{rule} {wildcards} ATTEMPT  FAILED" >> {FAIL_LOG}
            exit 1
        fi
        """

