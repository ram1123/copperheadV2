            cat=PLOT_CATS,
            njets_plot=PLOT_NJETS,
            jj_eta_region=JJ_ETA_REGIONS,
            zpt_mode=PLOT_ZPT_MODES,
            var_set=PLOT_VAR_SETS,
        ),



# ---------------------------------------
# 1) Stage-1 (all samples)
# ---------------------------------------
rule stage1:
    output:
        done="state/stage1_{year}.done",
    log:
        "logs/stage1_{year}.log",
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
          -c {params.yaml} \
          -v {params.nano} \
          -l {params.label} \
          -y "{wildcards.year}" \
          -m 1 \
          {params.gw}  \
          > {log} 2>&1
        touch {output.done}
        """


# ---------------------------------------
# 2) Compact Stage-1 Outputs
# ---------------------------------------
rule stage1Compact:
    input:
        "state/stage1_{year}.done",
    output:
        done="state/stage1_compact_{year}.done",
    log:
        "logs/stage1_compact_{year}.log",
    params:
        nano=lambda wc: nano_for_year(wc.year),
        yaml=lambda wc: yaml_for_year(wc.year),
        label=lambda wc: label_for_year(wc.year),
        gw=lambda wc: gw_flags(),
    resources:
        gateway=1,
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p state logs
        PYTHONUNBUFFERED=1 bash stage1_loop_Improved.sh \
            -c {params.yaml} \
            -v {params.nano} \
            -l {params.label} \
            -y "{wildcards.year}" \
            -m compact \
            {params.gw} \
            > {log} 2>&1
        touch {output.done}
        """


# ---------------------------------------
# 3) Plotter (depends on stage1 outputs)
# ---------------------------------------
rule plots:
    input:
        "state/stage1_compact_{year}.done"
    output:
        done="state/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.done"
    log:
        "logs/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.log"        
    params:
        gw=lambda wc: gw_flags_plots(),
        load_path=lambda wc: f"/depot/cms/hmm/{os.environ['USER']}/hmm_ntuples/copperheadV1clean/{label_for_year(wc.year)}/stage1_output/{wc.year}/f1_0",
        save_path=lambda wc: (
            f"validation/figs/Run3_nanoAODv{nano_for_year(wc.year)}/"
            f"{label_for_year(wc.year)}/VBFfilter_False/"
        ),
        # map wildcards -> CLI flags
        zpt_flag=lambda wc: "--remove_zpt_weights" if wc.zpt_mode == "nozpt" else "",
        minset_flag=lambda wc: "--minimum_set" if wc.var_set == "minset" else ""
    resources:
        gateway=1
    shell:
        r"""
        set -euo pipefail
        set -x
        mkdir -p state logs
        PYTHONUNBUFFERED=1 \
        python plotter/validation_plotter_unified.py \
            -y {wildcards.year} \
            --save_path {params.save_path} \
            --load {params.load_path} \
            --use-compacted "compacted" \
            -cat {wildcards.cat} \
            {params.gw} \
            --njets {wildcards.njets_plot} \
            --jj-eta-region "{wildcards.jj_eta_region}" \
            --region h-sidebands z-peak \
            {params.minset_flag} \
            {params.zpt_flag} \
            > {log} 2>&1 || true
        touch {output.done}
        """

# ---------------------------------------
# 4) ZpT weight computation (stage-0: Just prepare root files for data/mc for fitting) (depends on stage1 outputs)
# ---------------------------------------
