            njets_plot=PLOT_NJETS,
            jj_eta_region=JJ_ETA_REGIONS,
            zpt_mode=PLOT_ZPT_MODES,
            var_set=PLOT_VAR_SETS,
        ),


rule all_stage1:
    input:
        # (1) stage1 for all years
        expand("state/stage1_{year}.done", year=YEARS),
        # (2) stage1Compact for all years
        expand("state/stage1_compact_{year}.done", year=YEARS),
        # (3) plotter (after stage1)
        expand(
            "state/plots_{year}_{cat}_{njets_plot}_{jj_eta_region}_{zpt_mode}_{var_set}.done",
